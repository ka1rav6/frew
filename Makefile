MODE ?= release
BUILD := build/$(MODE)

CXXFLAGS := -std=c++20 -Wall -Wextra -Wpedantic
CPPFLAGS := -Isrc -Isrc/tensor_lib -Isrc/csv -Isrc/ml -MMD -MP
LDLIBS   := -pthread

ifeq ($(MODE),release)
  CXXFLAGS += -O3
  CPPFLAGS += -DNDEBUG -DDEBUG_MODE=0
else ifeq ($(MODE),debug)
  CXXFLAGS += -O0 -g3
  CPPFLAGS += -DDEBUG_MODE=1
else
  $(error MODE must be 'release' or 'debug', got '$(MODE)')
endif

# All .cpp files under a directory (silent if the directory doesn't exist yet)
find_cpp = $(shell find $(1) -type f -name '*.cpp' 2>/dev/null)
objs_of  = $(patsubst %.cpp,$(BUILD)/%.o,$(call find_cpp,$(1)))

SRC_OBJS   := $(call objs_of,src)
TEST_OBJS  := $(call objs_of,tests)
BENCH_OBJS := $(call objs_of,bench)

LIB       := $(BUILD)/libtensorlib.a
TEST_BIN  := $(BUILD)/bin/tests
BENCH_BIN := $(BUILD)/bin/bench

.PHONY: all debug test bench format clean
.DELETE_ON_ERROR:

all: $(LIB)

debug:
	$(MAKE) MODE=debug

$(LIB): $(SRC_OBJS)
	@rm -f $@
	$(AR) rcs $@ $^

$(BUILD)/%.o: %.cpp
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

test: $(TEST_BIN)
	./$<

$(TEST_BIN): $(TEST_OBJS) $(LIB)
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $^ -lgtest_main -lgtest $(LDLIBS) -o $@

bench: $(BENCH_BIN)
	./$<

$(BENCH_BIN): $(BENCH_OBJS) $(LIB)
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $^ $(LDLIBS) -o $@

format:
	find src tests bench -type f \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' \) \
		-exec clang-format -i {} + 2>/dev/null || true

clean:
	rm -rf build

# Header dependency files generated by -MMD
-include $(SRC_OBJS:.o=.d) $(TEST_OBJS:.o=.d) $(BENCH_OBJS:.o=.d)
